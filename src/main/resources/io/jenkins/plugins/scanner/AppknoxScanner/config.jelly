<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define"
    xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    <div class="appknox-scanner-block" style="background-color: #f0f4ff; border: 1px solid #c5d0e8; border-radius: 6px; padding: 12px 16px; margin: 4px 0;">
    <f:section title="Appknox Security Scanner Configuration">
        <f:entry title="${%credentialsId}" field="credentialsId">
            <f:select field="credentialsId" onchange="appknoxToggleCredentials(this)" />
        </f:entry>
        <f:entry title="${%serviceAccountCredentialsId}" field="serviceAccountCredentialsId">
            <f:select field="serviceAccountCredentialsId" onchange="appknoxToggleCredentials(this)" />
        </f:entry>
        <f:entry>
            <div style="margin-top: -8px; color: #666; font-size: 0.9em;">${%credentialsNote}</div>
        </f:entry>
        <f:entry title="${%filePath}" field="filePath">
            <f:textbox field = "filePath"/>
        </f:entry>
        <f:entry title="${%thresholdType}" field="thresholdType">
            <f:select field="thresholdType" onchange="appknoxToggleThreshold(this)" />
        </f:entry>
        <div id="appknox-risk-row">
        <f:entry title="${%riskThreshold}" field="riskThreshold">
            <f:select field="riskThreshold" />
        </f:entry>
        </div>
        <div id="appknox-health-row" style="display:none">
        <f:entry title="${%healthScoreThreshold}" field="healthScoreThreshold">
            <f:textbox field="healthScoreThreshold" />
        </f:entry>
        </div>
        <div id="appknox-likelihood-row" style="display:none">
        <f:entry title="${%exploitLikelihoodThreshold}" field="exploitLikelihoodThreshold">
            <f:select field="exploitLikelihoodThreshold" />
        </f:entry>
        </div>
        <f:entry title="${%region}" field="region">
            <f:select field="region" />
        </f:entry>
        <f:entry title="${%generatePdfReport}" field="generatePdfReport">
            <f:checkbox />
            <div style="margin-top: 1px; color: #666; font-size: 0.9em;">${%generatePdfReportNote}</div>
        </f:entry>
        <f:entry title="${%triggerKnoxiq}" field="triggerKnoxiq">
            <f:checkbox id="appknox-trigger-knoxiq-checkbox" />
            <div style="margin-top: 1px; color: #666; font-size: 0.9em;" id="appknox-trigger-knoxiq-note">${%triggerKnoxiqNote}</div>
        </f:entry>
        <script><![CDATA[
            function appknoxSyncCredentialsDisabled(container) {
                var tokenSelect = container.querySelector('select[name="_.credentialsId"]');
                var saSelect = container.querySelector('select[name="_.serviceAccountCredentialsId"]');
                if (!tokenSelect || !saSelect) return;
                var tokenSet = tokenSelect.value !== '';
                var saSet = saSelect.value !== '';
                // Only enforce exclusivity once one side is picked -- if both are
                // already set (a pre-existing invalid config), leave both enabled
                // so the user can clear either one via its dropdown.
                tokenSelect.disabled = saSet && !tokenSet;
                saSelect.disabled = tokenSet && !saSet;
            }
            function appknoxToggleCredentials(sel) {
                var container = sel.closest('.appknox-scanner-block');
                if (container) appknoxSyncCredentialsDisabled(container);
            }
            function appknoxAddHelpHint(select, label) {
                if (!select) return;
                var row = select.closest('.jenkins-form-item');
                var helpLink = row && row.querySelector('a.jenkins-help-button');
                if (!helpLink || helpLink.dataset.appknoxHintAdded) return;
                helpLink.dataset.appknoxHintAdded = 'true';
                // Replace core's generic "Help for feature: <title>" wording with
                // something that actually says what the field is, so hovering
                // tells you more than the field's own label already does.
                var hintedTitle = label + ' -- click for more details';
                helpLink.title = hintedTitle;
                helpLink.setAttribute('tooltip', hintedTitle);
                // Jenkins renders this tooltip via Tippy.js, which caches its own
                // content at init time -- mutating the title/tooltip attribute
                // alone doesn't refresh an already-initialized instance, so push
                // the update into Tippy directly on every hover as a just-in-time
                // refresh regardless of when Tippy attached to this element.
                helpLink.addEventListener('mouseenter', function() {
                    if (helpLink._tippy) helpLink._tippy.setContent(hintedTitle);
                });
            }
            function appknoxToggleThreshold(sel) {
                var val = sel.value;
                var riskRow = document.getElementById('appknox-risk-row');
                var healthRow = document.getElementById('appknox-health-row');
                var likelihoodRow = document.getElementById('appknox-likelihood-row');
                var knoxiqCheckbox = document.getElementById('appknox-trigger-knoxiq-checkbox');
                var knoxiqNote = document.getElementById('appknox-trigger-knoxiq-note');
                if (riskRow) riskRow.style.display = (val === 'RISK') ? '' : 'none';
                if (healthRow) healthRow.style.display = (val === 'HEALTH_SCORE') ? '' : 'none';
                if (likelihoodRow) likelihoodRow.style.display = (val === 'EXPLOIT_LIKELIHOOD') ? '' : 'none';
                if (knoxiqCheckbox) {
                    var forced = (val === 'EXPLOIT_LIKELIHOOD');
                    knoxiqCheckbox.disabled = forced;
                    if (forced) {
                        if (knoxiqCheckbox.dataset.prevChecked === undefined) {
                            knoxiqCheckbox.dataset.prevChecked = knoxiqCheckbox.checked;
                        }
                        knoxiqCheckbox.checked = true;
                    } else if (knoxiqCheckbox.dataset.prevChecked !== undefined) {
                        knoxiqCheckbox.checked = (knoxiqCheckbox.dataset.prevChecked === 'true');
                        delete knoxiqCheckbox.dataset.prevChecked;
                    }
                    if (knoxiqNote) {
                        knoxiqNote.textContent = forced
                            ? 'Automatically enabled -- required for Exploit Likelihood Threshold.'
                            : '${%triggerKnoxiqNote}';
                    }
                }
            }
            setTimeout(function() {
                document.querySelectorAll('.appknox-scanner-block').forEach(function(block) {
                    appknoxSyncCredentialsDisabled(block);
                    appknoxAddHelpHint(block.querySelector('select[name="_.credentialsId"]'), 'Appknox Personal Access Token');
                    appknoxAddHelpHint(block.querySelector('select[name="_.serviceAccountCredentialsId"]'), 'Appknox Service Account');
                    appknoxAddHelpHint(block.querySelector('[name="_.filePath"]'), 'Path to the APK/IPA file to scan');
                    appknoxAddHelpHint(block.querySelector('[name="_.thresholdType"]'), 'Which gate decides if the build fails');
                    appknoxAddHelpHint(block.querySelector('[name="_.riskThreshold"]'), 'Risk level that fails the build');
                    appknoxAddHelpHint(block.querySelector('[name="_.healthScoreThreshold"]'), 'Minimum health score required to pass');
                    appknoxAddHelpHint(block.querySelector('[name="_.exploitLikelihoodThreshold"]'), 'Minimum exploit likelihood that fails the build');
                    appknoxAddHelpHint(block.querySelector('[name="_.region"]'), 'Appknox region to scan against');
                });
                var selects = document.querySelectorAll('select[name="_.thresholdType"]');
                var sel = selects.length > 0 ? selects[selects.length - 1] : null;
                if (sel) {
                    appknoxToggleThreshold(sel);
                } else {
                    var riskRow = document.getElementById('appknox-risk-row');
                    var healthRow = document.getElementById('appknox-health-row');
                    var likelihoodRow = document.getElementById('appknox-likelihood-row');
                    if (riskRow) riskRow.style.display = '';
                    if (healthRow) healthRow.style.display = 'none';
                    if (likelihoodRow) likelihoodRow.style.display = 'none';
                }
            }, 100);
        ]]></script>
        <f:entry>
            <p>${%requiredFields}</p>
        </f:entry>
    </f:section>
    </div>
</j:jelly>
